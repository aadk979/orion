{
    "name": "r-sync",
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "start:orchestrator": "cd examples && node orchestrator.example.js",
        "start:worker": "cd examples && node worker.example.js",
